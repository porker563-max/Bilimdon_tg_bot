# @BotFather dan olingan yangi bot tokeni (kurslar botining tokenidan FARQLI bo'lsin)
BOT_TOKEN=

# Zayavkalar keladigan chat(lar). Guruh ID (-100...) yoki shaxsiy ID. Bir nechta bo'lsa vergul bilan.
# ID ni bilish: botni guruhga qo'shing va guruhda /id deb yozing.
LEADS_CHAT_IDS=

# /export (CSV) va /stats buyruqlarini ishlata oladiganlar ID lari, vergul bilan.
ADMIN_IDS=

# (ixtiyoriy) Google Sheets uchun Apps Script manzili — google_sheets.gs fayliga qarang.
SHEETS_WEBHOOK_URL=

# (ixtiyoriy) CRM (Fieldy va h.k.) API/webhook manzili va kaliti — keyin qo'shamiz.
CRM_WEBHOOK_URL=
CRM_API_KEY=

DB_PATH=leads.db
