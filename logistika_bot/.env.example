# @BotFather dan olingan bot tokeni
BOT_TOKEN=

# Zayavkalar keladigan chat(lar). Guruh ID (-100...) yoki shaxsiy ID. Bir nechta bo'lsa vergul bilan.
# ID ni bilish: botni guruhga qo'shing va guruhda /id deb yozing.
LEADS_CHAT_IDS=

# /export (CSV) va /stats buyruqlarini ishlata oladiganlar ID lari, vergul bilan.
ADMIN_IDS=

# (ixtiyoriy) Google Sheets uchun Apps Script manzili — google_sheets.gs fayliga qarang.
SHEETS_WEBHOOK_URL=

# (ixtiyoriy) CRM (Fieldy va h.k.) API/webhook manzili va kaliti — keyin qo'shamiz.
CRM_WEBHOOK_URL=
CRM_API_KEY=
# Kalit qaysi sarlavhada yuboriladi (Fieldy hujjatida yoziladi). Odatda Authorization (Bearer).
CRM_AUTH_HEADER=Authorization

DB_PATH=leads.db

# /post buyrug'i uchun: postlar joylanadigan kanal (@kanal_username yoki -100... ID).
# Botni kanalga admin qilib qo'shing ("Xabar joylash" huquqi bilan).
CHANNEL_ID=
# Post tagidagi tugma matni
BUTTON_TEXT=📝 Ro'yxatdan o'tish
