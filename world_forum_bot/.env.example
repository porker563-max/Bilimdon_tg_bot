# ===== World Forum Consulting boti sozlamalari =====
# Bu faylni .env deb nusxalang va to'ldiring. .env GitHub ga yuklanmaydi.

# @BotFather dan olingan bot tokeni
BOT_TOKEN=

# Zayavkalar keladigan guruh ID si (-100...). Bir nechta bo'lsa vergul bilan, bo'sh joysiz.
# ID ni bilish: botni guruhga qo'shing va guruhda /id@BotUsername deb yozing.
LEADS_CHAT_IDS=

# Admin(lar) Telegram ID si — /post, /export, /stats ni faqat shular ishlata oladi. Vergul bilan.
ADMIN_IDS=

# /post bilan postlar joylanadigan kanal: @kanal_username yoki -100... ID.
# Bot kanalda ADMIN bo'lishi kerak ("Xabar joylash" huquqi bilan).
CHANNEL_ID=

# Post tagidagi tugma matni
BUTTON_TEXT=📝 Ro'yxatdan o'tish

# Kompaniya nomi (salomlashishda chiqadi)
COMPANY_NAME=World Forum Consulting

# (ixtiyoriy) Google Sheets — google_sheets.gs fayliga qarang
SHEETS_WEBHOOK_URL=

# (ixtiyoriy) Fieldy CRM: kontakt yaratish manzili va API kalit
CRM_WEBHOOK_URL=
CRM_API_KEY=
# Kalit qaysi sarlavhada yuboriladi. Odatda Authorization (Bearer). Fieldy boshqasini talab qilsa — o'sha nom.
CRM_AUTH_HEADER=Authorization
